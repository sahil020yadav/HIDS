# Copy this file to .env and fill in real values. Never commit .env itself.

# Used to sign JWTs. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# JWT algorithm and expiry
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite by default. For Postgres later: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./database/hids.db

# Path to your trained model artifact (relative to backend/)
MODEL_PATH=ml/model/hids_model.pkl

# Optional: paths to separate preprocessing objects, if you did NOT save a
# single sklearn Pipeline. Leave blank if not used - the loader will skip
# any that don't exist.
SCALER_PATH=ml/model/scaler.pkl
ENCODER_PATH=ml/model/encoder.pkl
FEATURE_SELECTOR_PATH=ml/model/feature_selector.pkl
SELECTED_FEATURES_PATH=ml/model/selected_features.pkl

# CORS - comma-separated origins allowed to call this API.
# Since the frontend is now static files served over plain HTTP (not Vite),
# include whatever port you serve it on, e.g. python -m http.server 5500.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080